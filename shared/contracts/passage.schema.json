{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic corpus passage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "panel", "analyte", "aliases", "band", "title", "text", "simulatedUrl"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-(low|normal|high)$"
    },
    "panel": {
      "type": "string",
      "enum": [
        "full_blood_count",
        "urea_and_electrolytes",
        "liver_tests",
        "hba1c",
        "lipids",
        "thyroid",
        "iron_studies"
      ]
    },
    "analyte": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "band": {
      "type": "string",
      "enum": ["low", "normal", "high"]
    },
    "title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "simulatedUrl": {
      "type": "string",
      "pattern": "^https://example\\.nhs\\.uk/explain/[a-z0-9-]+$"
    }
  }
}
